+# glm53-run diagnostic (GLM53_BOUNDS_CHECK=1): verify every KV-group slot mapping stays
+# inside its cache before the forward writes with it; raises a Python error instead of an
+# MMU fault (Xid 31 wedges the driver until reboot). One host sync per step when enabled.
+_GLM53_BOUNDS_CHECK = os.environ.get("GLM53_BOUNDS_CHECK") == "1"
+
+
+def _glm53_check_slot_mappings(tag: str, slot_mappings, kv_cache_config) -> None:
+    if not _GLM53_BOUNDS_CHECK:
+        return
+    for gi, (sm, group) in enumerate(zip(slot_mappings, kv_cache_config.kv_cache_groups)):
+        if sm.numel() == 0:
+            continue
+        cap = kv_cache_config.num_blocks * group.kv_cache_spec.block_size
+        s64 = sm.to(torch.int64)
+        mx, mn = int(s64.max().item()), int(s64.min().item())
+        if mx >= cap or mn < -1:
+            raise RuntimeError(
+                f"GLM53_BOUNDS_CHECK: {tag}: kv group {gi} ({group.layer_names[:2]}...) "
+                f"slot range [{mn}, {mx}] outside capacity {cap} "
+                f"(num_blocks={kv_cache_config.num_blocks}, block_size={group.kv_cache_spec.block_size})"
+            )
+
+
