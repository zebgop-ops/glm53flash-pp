+            "device=%s data_ptr=0x%x storage_bytes=%d | allocated=%.2f GiB reserved=%.2f GiB",
+            tuple(marlin_scales.shape), marlin_scales.stride(), marlin_scales.dtype,
+            marlin_scales.is_contiguous(), marlin_scales.device, marlin_scales.data_ptr(),
+            marlin_scales.untyped_storage().nbytes(),
+            _cuda.memory_allocated(marlin_scales.device) / 2**30,
+            _cuda.memory_reserved(marlin_scales.device) / 2**30,
+        )
+    max_val = None
+    if marlin_scales.dim() == 0:
+        slices = [marlin_scales.reshape(1)]
+    else:
+        slices = marlin_scales.unbind(0) if marlin_scales.shape[0] > 1 else [marlin_scales]
+    for sl in slices:
+        ws_float = sl.float() * (2**7)
+        pos = ws_float[ws_float > 0]
+        if pos.numel():
+            m = pos.max()
+            max_val = m if max_val is None else torch.maximum(max_val, m)
+    if max_val is not None and max_val < 448 * (2**7):
+        sf = (448 * (2**7) / max_val).log2().floor().exp2()
+        return sf.item()
     return 1.0
 
 
