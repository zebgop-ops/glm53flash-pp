+    # glm53 overlay (sm_80 / CMP 170HX): the stock version materialises a float32
+    # copy of the whole [E, 2N, K/16] scale tensor (1.2 GB for GLM-5.3-Flash) plus a
+    # boolean mask and a masked gather of the same size. In situ (rank holding ~45 GB
+    # of weights) the first of those kernels raised an illegal memory access on
+    # every rank, while the identical call on the identical tensors passes in
+    # isolation. Compute the same maximum per leading slice instead (a few MB of
+    # transient per step) and log what we were handed, so a recurrence names the
+    # tensor rather than the kernel.
+    import os as _os
+    if _os.environ.get("GLM53_MARLIN_DIAG"):
+        import torch.cuda as _cuda
+        logger.info(
